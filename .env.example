# Resend — sends Reach Us form enquiries by email.
# 1. Create an API key at https://resend.com/api-keys
# 2. Put it here in .env.local (locally) and in your Vercel project's
#    Environment Variables (production). Never commit the real key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender shown on enquiry emails. The onboarding address works immediately
# with Resend (it can send to the email you signed up to Resend with).
# Once you verify your own domain in Resend, replace it, e.g.:
# RESEND_FROM_EMAIL=Openroad Website <website@yourdomain.com>
RESEND_FROM_EMAIL=Openroad Website <onboarding@resend.dev>

# Inbox that receives form enquiries.
CONTACT_TO_EMAIL=minanicalm@gmail.com
